# Trengs bare for å forhåndsvise siden på egen PC (se README.md).
# GitHub Pages bruker ikke denne filen.
source "https://rubygems.org"

gem "jekyll", "~> 3.10"          # samme hovedversjon som GitHub Pages
gem "kramdown-parser-gfm"         # Markdown som på GitHub
gem "webrick"                     # lokal webserver
gem "csv"
gem "base64"
gem "bigdecimal"

group :jekyll_plugins do
  gem "jekyll-relative-links"     # gjør [lenke](side.md) om til side.html
  gem "jekyll-redirect-from"      # redirect_from: i front matter
end

gem "tzinfo-data", platforms: [:windows]
gem "wdm", ">= 0.1.0", platforms: [:windows]
